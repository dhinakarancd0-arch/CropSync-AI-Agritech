# AgriDirect Environment Configuration (.env.example)

# Application
APP_NAME=AgriDirect
APP_VERSION=1.0.0
DEBUG=True

# Database Configuration (SQLite default for quick local demo; or PostgreSQL in production)
# SQLite:
DATABASE_URL=sqlite:///./agridirect.db
# PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agridirect_db

# JWT Security
SECRET_KEY=agridirect-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Demo Credentials
DEMO_PASSWORD=AgriDirect2024!

# Optional Gemini API Key for Agro-Advisory Explanations
# GEMINI_API_KEY=your_gemini_api_key_here
